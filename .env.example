# Copy this file to ".env" and fill it in. Never share or commit the .env file.

# The address the API will answer on, for example api.yourschool.org
DOMAIN=api.example.com

# Database password. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Signs the sign-in tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me

# Web addresses allowed to call the API from a browser, separated by commas.
# Leave empty until the web app has an address, for example https://app.yourschool.org
CORS_ORIGINS=
